# Note: Copy these variables in your .env file

# PostgreSQL connection string (required — SQLite no longer supported)
# Example: postgresql://user:password@host:5432/jobsync
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobsync

# Non-pooled connection, used by Prisma Migrate (schema.prisma's directUrl).
# On Neon this is the DATABASE_URL host with "-pooler" removed; on a plain
# Postgres it is the same value as DATABASE_URL.
DIRECT_URL=postgresql://postgres:password@localhost:5432/jobsync

# LavinMQ AMQP connection string (required for CV generation queue)
# Example: amqp://user:password@host:5672
LAVINMQ_URL=amqp://guest:guest@localhost:5672

# If you are running it on a remote server/homelab, you must update timezone otherwise activities times may shift
TZ=America/Edmonton

# ENCRYPTION_KEY is used to encrypt stored API keys (OpenAI, DeepSeek, RapidAPI)
# Must be stable across restarts — changing it will make all stored API keys unrecoverable
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

OPENAI_API_KEY=your-openai-api-key-here

# DeepSeek API Key - get from https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Google Gemini API Key - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# For homelab server, if you ollama is running on server, change the following to your ollamma ip ex: http://192.168.x.x:12345
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI Configuration
# The system uses LLM-based semantic extraction for intelligent, context-aware skill matching
# No configuration needed - semantic extraction is the default

RAPIDAPI_KEY=your-rapidapi-key-here

# Shared secret used by the external CV generation worker to authenticate callbacks
# Must match the Bearer token sent in the worker's Authorization header
# Generate with: openssl rand -hex 32
CV_WEBHOOK_SECRET=

# --- Toka Auth (central SSO via Clerk) -----------------------------------
# Authentication is delegated to the Toka auth app; this app has no sign-in
# page of its own. All TOKA_* vars have defaults, so a blank value will not
# crash the app -- but the Clerk keys below are required for any request to
# resolve a session.

# Read by @toka-auth/config to build Clerk's authorizedParties list.
TOKA_ROOT_DOMAIN=tokadream.com
TOKA_AUTH_SUBDOMAIN=accounts
# Comma-separated app slugs. Each becomes https://<slug>.<TOKA_ROOT_DOMAIN>
# in Clerk's authorizedParties allowlist (no wildcard support).
#
# THIS APP'S OWN SLUG MUST BE HERE. Leave it out and Clerk rejects easyjobs'
# own session tokens with token-invalid-authorized-parties.
#
# Sibling apps do NOT belong here. SSO across *.tokadream.com works from the
# shared session cookie without this list, and easyjobs' frontend only calls
# its own routes. Only add another app's slug if that app's frontend calls
# easyjobs' API cross-origin -- otherwise you are just widening which origins
# easyjobs will accept a token from.
#
# The auth app is the exception: it lists every slug, because it renders them
# as the app launcher and validates inviteUser() against them.
TOKA_APPS=easyjobs
# Local dev only: this app's own origin, so tokens minted against
# http://localhost:3000 are accepted. Remove in production.
TOKA_APP_DOMAINS=http://localhost:3000

# Clerk -- must be the SAME Clerk application as the auth app's, so sessions
# created on accounts.<root domain> are recognised here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where unauthenticated visitors are sent. Always the central auth app --
# this app hosts no sign-in UI of its own. The Clerk keys above must belong to
# the SAME instance that serves this URL.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://accounts.tokadream.com/sign-in
# Optional: enables networkless JWT verification.
CLERK_JWT_KEY=
